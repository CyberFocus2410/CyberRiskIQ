# CyberRiskIQ Production & Multi-Tenant Environment Template
# Copy this file to .env for local development or configure in Render/Vercel/Fly.io dashboards.

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Local SQLite)
# -------------------------------------------------------------
# For Local Development (Default SQLite):
DATABASE_URL=sqlite:///./cyberriskiq.db

# For Production (Supabase PostgreSQL Connection Pooler):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# -------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# -------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# -------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# -------------------------------------------------------------
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------
# 4. FRONTEND ENVIRONMENT CONFIGURATION (Vite)
# -------------------------------------------------------------
# For local development with Vite proxy, leave empty.
# For production (e.g. Vercel), set to your deployed backend URL:
# VITE_API_URL=https://cyberriskiq-api.onrender.com

# -------------------------------------------------------------
# 5. AI ANALYST ENGINE CONFIGURATION (Optional Grounding)
# -------------------------------------------------------------
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# -------------------------------------------------------------
# 6. SECURITY ASSESSMENT ENGINE
# -------------------------------------------------------------
ASSESSMENT_API_URL=http://localhost:8000/api/assessment
ASSESSMENT_MODE=DEMONSTRATION # Options: DEMONSTRATION, LIVE
