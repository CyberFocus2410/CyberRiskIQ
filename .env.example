# CyberRiskIQ Environment Configuration Template
# Copy this file to .env and configure for your local/production environment.

# Database Configuration
DATABASE_URL=sqlite:///./cyberriskiq.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/cyberriskiq

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# AI Analyst Configuration (Optional external LLM grounding endpoint)
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# Security Assessment Engine Settings
ASSESSMENT_API_URL=http://localhost:8000/api/assessment
ASSESSMENT_MODE=DEMONSTRATION # Options: DEMONSTRATION, LIVE

# Security & Session Authentication
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
